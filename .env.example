# EvoMem memory_service wiring — copy to .env and fill in.
# All four MEMSVC_* vars are read once at canary startup by canary/tools/memory.py.
# When MEMSVC_BASE_URL or MEMSVC_ORG is set, the four memory tools register
# automatically and the memory policy is appended to the system prompt.

MEMSVC_BASE_URL=http://localhost:9200
MEMSVC_ORG=acme
MEMSVC_REPO=greenfield-service
MEMSVC_AGENT=canary-agent
# MEMSVC_TOKEN=                 # set if memory_service has MEMSVC_AUTH_TOKEN enabled

# Upstream LLM (Copilot / OpenAI-compatible)
# COPILOT_BASE_URL=http://localhost:4141
# CANARY_MODEL=claude-sonnet-4.5
